# CRAG-Demo Environment Variables
# Copy to .env and fill in values as needed.

# PostgreSQL Admin (仅初始化和健康检查使用，不注入 Java 容器)
POSTGRES_ADMIN_PASSWORD=admin_demo

# 业务数据库密码
CARG_ACCESS_PASSWORD=access_demo
CARG_KNOWLEDGE_PASSWORD=knowledge_demo
CARG_RAG_PASSWORD=rag_demo

# 服务间 gRPC 身份凭据
CONSOLE_API_SERVICE_TOKEN=console-token-demo
OPEN_API_SERVICE_TOKEN=open-token-demo
RAG_API_SERVICE_TOKEN=rag-token-demo
KNOWLEDGE_API_SERVICE_TOKEN=knowledge-token-demo

# 服务 Profile（plan_21/21.11 收敛单服务 Smoke 拓扑）
# 空（默认）：原服务不注册 Smoke Controller，固定端口只暴露 /actuator/health/**。
# smoke：原服务在固定端口额外注册 /api/v1/smoke/** 诊断 Controller，使用 application-smoke.yml 测试密钥与事件闭环。
# 启用方式：CRAG_SERVICE_PROFILES=smoke 后执行 docker compose up -d --build。
CRAG_SERVICE_PROFILES=

# LLM Provider: stub (default, no credentials) or deepseek
CRAG_QUERY_LLM_PROVIDER=stub

# Stub mode: success (returns fixed answer) or failure (returns 502)
CRAG_QUERY_LLM_STUB_MODE=success

# DeepSeek Anthropic API (only needed when CRAG_QUERY_LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY 禁止写入 .env 文件；仅通过宿主环境变量临时注入
# DEEPSEEK_API_KEY=
# CRAG_QUERY_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# CRAG_QUERY_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
# CRAG_QUERY_LLM_DEEPSEEK_TEMPERATURE=0
# CRAG_QUERY_LLM_DEEPSEEK_MAX_OUTPUT_TOKENS=4096
# CRAG_QUERY_LLM_REQUEST_TIMEOUT=120s
