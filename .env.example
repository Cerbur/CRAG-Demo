# CRAG-Demo Environment Variables
# Copy to .env and fill in values as needed.

# LLM Provider: stub (default, no credentials) or deepseek
CRAG_QUERY_LLM_PROVIDER=stub

# Stub mode: success (returns fixed answer) or failure (returns 502)
CRAG_QUERY_LLM_STUB_MODE=success

# DeepSeek Anthropic API (only needed when CRAG_QUERY_LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=
# CRAG_QUERY_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# CRAG_QUERY_LLM_DEEPSEEK_MODEL=deepseek-v4-flash
# CRAG_QUERY_LLM_DEEPSEEK_TEMPERATURE=0
# CRAG_QUERY_LLM_DEEPSEEK_MAX_OUTPUT_TOKENS=4096
# CRAG_QUERY_LLM_REQUEST_TIMEOUT=120s
